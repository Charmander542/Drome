# Required for in-app Spotify search (wishlist + Search tab).
# SpotiFLAC downloads never need Spotify developer credentials.
DROME_SPOTIFY_CLIENT_ID=
DROME_SPOTIFY_CLIENT_SECRET=
# ISO country code for Search (required with client-credentials tokens).
DROME_SPOTIFY_MARKET=US

# Optional: Navidrome user that can trigger library scans after a download.
# Without these, Navidrome picks files up on ND_SCANSCHEDULE (hourly is fine).
DROME_NAVIDROME_SCAN_USER=
DROME_NAVIDROME_SCAN_PASSWORD=

DROME_AUTO_DOWNLOAD=true
DROME_SPOTIFLAC_SERVICES=tidal,qobuz,amazon,deezer

# Public HTTPS origin for iMessage share cards / Universal Links (no trailing slash).
# The iOS app's Associated Domains must include this host (see Drome.entitlements).
# DROME_PUBLIC_URL=https://drome.example.com
# DROME_AASA_APP_ID=LURJ69YS93.drome.app
