      "status": "ready",
      "actions": [
        {
          "id": "pick_account",
          "title": "Pick account",
          "type": "tap",
          "to": "onboarding_gate"
        },
        {
          "id": "close",
          "title": "Done",
          "type": "tap",
          "to": "login"
        }
      ]
    },
    {
      "id": "onboarding_gate",
      "title": "Onboarding?",
