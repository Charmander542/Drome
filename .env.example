# Required for in-app Spotify search (wishlist + Search tab).
# Mornye downloads never need Spotify developer credentials.
DROME_SPOTIFY_CLIENT_ID=
DROME_SPOTIFY_CLIENT_SECRET=
# ISO country code for Search (required with client-credentials tokens).
DROME_SPOTIFY_MARKET=US

# Optional but recommended: Navidrome admin (or playlist-capable) user.
# Used to trigger library scans AND to create/update public playlists for
# Spotify imports during background downloads. Playlists are owned by this
# account (or the requesting user at import time) and marked public so the
# household can see them. Without these, Drome still writes Playlists/*.m3u8
# files that Navidrome imports on ND_SCANSCHEDULE.
# Recommended: Navidrome admin (or playlist-capable) user so background
# downloads can append new tracks to imported playlists. Without these,
# Drome still rewrites Playlists/*.m3u8 and will reuse the last authenticated
# app session's Subsonic credentials when available.
DROME_NAVIDROME_SCAN_USER=
DROME_NAVIDROME_SCAN_PASSWORD=

DROME_AUTO_DOWNLOAD=true
DROME_SPOTIFLAC_SERVICES=tidal,qobuz,amazon,deezer,youtube
# Genre tags come from Discogs (primary) with MusicBrainz + Deezer fallbacks.
# No API key required. Cache lives next to DROME_DB_PATH as genre_cache.sqlite.
# DROME_GENRE_BIN=drome-genre-tag
# Mornye has no built-in providers — point at an extension registry.
# MORNYE_REGISTRIES=https://raw.githubusercontent.com/mornyeapp/Mornye-Extension/main/registry.json,https://raw.githubusercontent.com/mornyeapp/Mornye-Extension/main/registry-python.json
# DROME_SPOTIFLAC_EXTENSIONS=utilities,tidal-web,qobuz-web,amazon,deezer,ytmusic-spotiflac
# Optional pause between Mornye jobs to avoid api.zarz.moe rate limits.
# DROME_DOWNLOAD_JOB_GAP=8s
# When a Spotify Singles exclusive isn't on Tidal/Qobuz/etc., download the
# nearest non-exclusive Spotify recording of the same song (default on).
# DROME_SPOTIFY_SINGLE_ALTERNATES=true

# Public HTTPS origin for iMessage share cards / Universal Links (no trailing slash).
# The iOS app's Associated Domains must include this host (see Drome.entitlements).
# Live companion: https://wishlist.charlesvanhook.com
# DROME_PUBLIC_URL=https://wishlist.charlesvanhook.com
# DROME_AASA_APP_ID=LURJ69YS93.drome.app

# Cloudflare Tunnel token for guest remote access (never commit the real value).
# Create a remotely-managed tunnel in Zero Trust → Networks → Tunnels, then:
#   docker compose --profile cloudflare up -d
# CLOUDFLARE_TUNNEL_TOKEN=
