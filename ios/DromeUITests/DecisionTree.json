{
  "version": 1,
  "app": "Drome",
  "notes": "Edit priority/status here or in the canvas. Walker follows priorityCritical paths first, then priorityHigh.",
  "nodes": [
    {
      "id": "splash",
      "title": "Splash",
      "kind": "screen",
      "a11y": "drome.splash.screen",
      "priority": "critical",
      "status": "ready",
      "actions": [
        {
          "id": "auto_dismiss",
          "title": "Auto-dismiss (~2s)",
          "type": "wait",
          "to": "auth_gate"
        }
      ]
    },
    {
      "id": "auth_gate",
      "title": "Auth gate",
      "kind": "decision",
      "priority": "critical",
      "status": "ready",
      "actions": [
        {
          "id": "signed_out",
          "title": "No session",
          "type": "branch",
          "to": "login"
        },
        {
          "id": "signed_in",
          "title": "Has session",
          "type": "branch",
          "to": "onboarding_gate"
        },
        {
          "id": "uitest_hook",
          "title": "-UITestPodcastMini / -UITestWalk",
          "type": "branch",
          "to": "shell"
        }
      ]
    },
    {
      "id": "login",
      "title": "Login",
      "kind": "screen",
      "a11y": "drome.login.screen",
      "priority": "critical",
      "status": "ready",
      "actions": [
        {
          "id": "sign_in",
          "title": "Sign In",
          "type": "tap",
          "a11y": "drome.login.sign-in",
          "to": "onboarding_gate",
          "screenshot": true
        },
        {
          "id": "saved_accounts",
          "title": "Saved accounts",
          "type": "tap",
          "a11y": "drome.login.saved-accounts",
          "to": "accounts_sheet"
        }
      ]
    },
    {
